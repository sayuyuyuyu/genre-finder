{
  "name": "genre-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "曲名・音声ファイル・Spotify/YouTube リンクから音楽ジャンルを判定するアプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "preview:cf": "pnpm build && wrangler pages dev dist --port 8788",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name genre-finder --branch main"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsmediatags": "^3.9.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
